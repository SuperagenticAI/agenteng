# Default requests use lookup; engine selection is explicit.
AGENTENG_ENABLE_STANDARD=0
AGENTENG_ENABLE_RLM=0
AGENTENG_PUBLIC_URL=https://a2a.agentengineering.world
# Optional model operations require a server-side token and a configured model.
# AGENTENG_OPERATOR_TOKEN=
# AGENTENG_MODEL_API_KEY=
# AGENTENG_MODEL_BASE_URL=https://api.openai.com/v1
# AGENTENG_MODEL=
# AGENTENG_CATALOGUE=/absolute/path/catalogue.json
AGENTENG_ALLOWED_ORIGINS=https://agentengineering.world

# Single-organizer private intake pilot; default off. Requires persistent private storage.
AGENTENG_ENABLE_INTAKE=0
# AGENTENG_INBOX=/persistent/private/agenteng.sqlite3
# AGENTENG_INTAKE_PRIVACY_NOTICE=Operator-approved notice: recipient, use, deletion contact, retention and backups.
AGENTENG_INTAKE_RETENTION_DAYS=90
AGENTENG_INTAKE_CAPACITY=1000
# AGENTENG_CALLS=/persistent/private/calls.json
# Client-only credential issued separately for each participant; never commit it.
# AGENTENG_PARTICIPANT_TOKEN=
