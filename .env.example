# CLI output: json always prints Result JSON (same as --json). Unset: cards on a TTY, JSON when piped.
# AGENTENG_OUTPUT=json
# Optional local agenteng code logs; default $XDG_CONFIG_HOME/agenteng, else ~/.config/agenteng.
# AGENTENG_CONFIG_DIR=~/.config/agenteng

# Default requests use lookup; engine selection is explicit.
AGENTENG_ENABLE_STANDARD=0
AGENTENG_ENABLE_RLM=0
AGENTENG_ENABLE_CHAT=0
AGENTENG_PUBLIC_URL=https://a2a.agentengineering.world
# Optional model operations require a server-side token and a configured model.
# AGENTENG_OPERATOR_TOKEN=
# AGENTENG_MODEL_API_KEY=
# AGENTENG_MODEL_BASE_URL=https://api.openai.com/v1
# AGENTENG_MODEL=
# Public chat: enable CHAT and set the three MODEL variables above.
# OpenRouter: base URL https://openrouter.ai/api/v1, model openrouter/free.
# CHAT is separate from the operator-only STANDARD/RLM engines.
# AGENTENG_CATALOGUE=/absolute/path/catalogue.json
AGENTENG_ALLOWED_ORIGINS=https://agentengineering.world
